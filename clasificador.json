{
  "preprocessing": {
    "unique_category_threshold": 50,
    "missing_values": "delete",
    "impute_strategy": "mean",
    "scaling": "minMax",
    "cat2num": "oneHot",
    "text_process": "tf-idf",
    "sampling": "smote",
    "drop_features": ["reviewId"],
    "lemmatization": "lem"
  },
  
  "knn_config": {
      "k": [-1, 5, 7, 1],
      "p": [1,2],
      "weights": ["uniform","distance"],
      "pares": true
  },
  "decision_tree_config": {
      "criterion": ["gini","entropy"],
      "max_depth": [-1,4,8,1],
      "min_samples_split": [2, 5, 10],
      "min_samples_leaf": [1, 2, 4],
      "max_features": ["sqrt", "log2"]
  },
  "rf_config": {
      "n_estimators": [50, 100, 150],
      "max_depth": [5, 10],
      "min_samples_split": [2, 5, 10],
      "min_samples_leaf": [1, 2, 4],
      "bootstrap": [true, false],
      "max_features": ["sqrt", "log2"]
  },
  "nb_config": {
      "alpha": [0.01, 0.1, 0.5, 1.0],
      "fit_prior": [true, false]
  },
  "lr_config": {
      "C": [0.01, 0.1],
      "l1_ratio": [0, 1],
      "solver": ["saga"],
      "max_iter": [100]
  },

  "test_size": 0.15,
  "dev_size": 0.15,
  "algorithm": "knn",
  "estimator": "f1_macro",

  "clustering": {
      "cluster": "lda",
      "textClustering": "content",

      "lda": {
        "num_topics": [3, 5, 7, 10],
        "passes": [10, 20],
        "iterations": [100]
      },
      "nmf": {
        "num_topics": [2,3,4,5,6,7,8,9,10],
        "passes": [5,10,20],
        "iterations": [50,100,200]
      }
  }
}

{
  "preprocessing": {
    "missing_values": "drop",
    "impute_strategy": "mean",
    "unique_category_threshold": 10,
    "scaling": "standard",
    "text_process": "tf-idf",
    "sampling": "none",
    "drop_features": []
  },
  "kNN": {
    "n_neighbors": [1, 3, 5],
    "weights": ["uniform", "distance"],
    "p": [1, 2]
  },
  "decision_tree": {
    "max_depth": [3, 6, 9],
    "min_samples_split": [2, 5],
    "criterion": ["gini", "entropy"]
  },
  "train":{
  "method": "KNN",
  "balance_threshold": 0.4,
    "target": "clase_objetivo"
  }
}
